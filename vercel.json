{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(jpg|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.767lemos.com"
        }
      ],
      "destination": "https://767lemos.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.767lemos.com"
        }
      ],
      "destination": "https://767lemos.com/",
      "permanent": true
    },
    {
      "source": "/active-listing/767-lemos",
      "has": [
        {
          "type": "host",
          "value": "767lemos.com"
        }
      ],
      "destination": "https://767lemos.com/",
      "permanent": false
    },
    {
      "source": "/:path((?!active-listing/767-lemos/|assets/|api/|_vercel/|favicon|robots\\.txt).+)",
      "has": [
        {
          "type": "host",
          "value": "767lemos.com"
        }
      ],
      "destination": "https://www.pandey.realty/:path",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "767lemos.com"
        }
      ],
      "destination": "/active-listing/767-lemos"
    }
  ]
}
