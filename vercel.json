{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(jpg|png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "767lemos.com"
        }
      ],
      "destination": "https://www.pandey.realty/active-listing/767-lemos",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.767lemos.com"
        }
      ],
      "destination": "https://www.pandey.realty/active-listing/767-lemos",
      "permanent": true
    }
  ]
}
